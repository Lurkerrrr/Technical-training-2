@using DotHotel.Core.DataTransferObjects.ReservationObjects
@using DotHotel.Core.Enums

@model List<ReservationResponse>
@{
    ViewData["Title"] = "Manage Reservations";
    Layout = "_Layout";
    var searchOptions = ViewBag.SearchOptions as ReservationSearchOptions ?? new ReservationSearchOptions();
}

<div class="container mt-3">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 mb-2">Manage Reservations</h1>
                    <p class="text-muted">Total reservations: @Model.Count</p>
                </div>
            </div>
        </div>
    </div>

    <partial name="Partial/_ReservationSearchOptions" model="searchOptions" />

    <div class="row">
        <div class="col-12">
            @if (Model.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        @foreach (var reservation in Model)
                        {
                            <div class="reservation-admin-item border-bottom p-3">
                                <div class="row align-items-center">
                                    <div class="col-md-7">
                                        <h5 class="mb-1">@reservation.Apartment.Name</h5>
                                        <p class="text-muted mb-2 small">
                                            @reservation.CheckInDate.ToString("MMM dd, yyyy") - @reservation.CheckOutDate.ToString("MMM dd, yyyy")
                                        </p>
                                        <div class="d-flex gap-4 text-muted small">
                                            <span>
                                                <i class="fas fa-users me-1"></i>
                                                <strong>@reservation.GuestCount</strong> guests
                                            </span>
                                            <span>
                                                <i class="fas fa-dollar-sign me-1"></i>
                                                <strong>$@reservation.TotalPriceUsd</strong>
                                            </span>
                                        </div>

                                        <div class="mt-2 small">
                                            <i class="fas fa-user me-1"></i><strong>@reservation.ReservationHolder.FirstName @reservation.ReservationHolder.LastName</strong>
                                            (<a href="mailto:@reservation.ReservationHolder.Email">@reservation.ReservationHolder.Email</a>)
                                        </div>
                                    </div>

                                    <div class="col-md-5">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    title="Cancel" onclick="openCancelModal('@reservation.Id', '@reservation.Apartment.Name')">
                                                <i class="fas fa-times-circle"></i> Cancel
                                            </button>

                                            @if (reservation.ReservationStatus == ReservationStatus.Pending)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success"
                                                        onclick="openPaymentModal('@reservation.Id', 'Cash')" title="Paid with Cash">
                                                    <i class="fas fa-money-bill-wave"></i> Paid with Cash
                                                </button>
                                            }

                                            <form asp-area="Administrator" asp-controller="Reservation" asp-action="ConfirmCheckIn" asp-route-reservationId="@reservation.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-primary"
                                                        title="Check-in" disabled="@(DateTime.UtcNow.Date != reservation.CheckInDate.Date || reservation.ReservationStatus != ReservationStatus.Confirmed)">
                                                    <i class="fas fa-door-open"></i> Check-in
                                                </button>
                                            </form>

                                            <form asp-area="Administrator" asp-controller="Reservation" asp-action="ConfirmCheckOut" asp-route-reservationId="@reservation.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                        title="Check-out" disabled="@(DateTime.UtcNow.Date != reservation.CheckOutDate.Date || reservation.ReservationStatus != ReservationStatus.CheckedIn)">
                                                    <i class="fas fa-door-closed"></i> Check-out
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-calendar-times fa-4x text-muted mb-4"></i>
                        <h4>No reservations found</h4>
                        <p class="text-muted mb-4">You haven't made any reservations yet.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-area="Administrator" asp-controller="Reservation" asp-action="ConfirmPayment">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="paymentModalLabel">Confirm Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="paymentReservationId" name="ReservationId" value="" />
                    <input type="hidden" id="paymentMethod" name="PaymentMethod" value="" />
                    <p>Are you sure you want to proceed with payment using <strong id="paymentMethodText"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-credit-card me-1"></i>Pay Now
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="cancelReservationModal" tabindex="-1" aria-labelledby="cancelReservationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelReservationModalLabel">Confirm Cancellation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to cancel reservation "<strong id="cancelReservationName"></strong>"?</p>
                <p class="text-muted small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a id="confirmCancelButton" asp-area="" asp-controller="Reservation" asp-action="CancelReservation" asp-route-reservationId="@Guid.Empty" class="btn btn-danger">
                    <i class="fas fa-times-circle me-1"></i> Cancel Reservation
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openPaymentModal(reservationId, paymentMethod) {
            $('#paymentReservationId').val(reservationId);
            $('#paymentMethod').val(paymentMethod);
            $('#paymentMethodText').text(paymentMethod);
            var modal = new bootstrap.Modal(document.getElementById('paymentModal'));
            modal.show();
        }

        function openCancelModal(reservationId, reservationName) {
            let currentHref = $("#confirmCancelButton").attr("href");
            let updatedHref = currentHref.replace("00000000-0000-0000-0000-000000000000", reservationId);
            $("#confirmCancelButton").attr("href", updatedHref);
            $("#cancelReservationName").text(reservationName);

            var modal = new bootstrap.Modal(document.getElementById('cancelReservationModal'));
            modal.show();
        }
    </script>

    <style>
        .reservation-admin-item {
            transition: background-color 0.2s ease;
        }

            .reservation-admin-item:hover {
                background-color: var(--bg-tertiary);
            }

            .reservation-admin-item:last-child {
                border-bottom: none !important;
            }

        .btn-sm {
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
    </style>
}
