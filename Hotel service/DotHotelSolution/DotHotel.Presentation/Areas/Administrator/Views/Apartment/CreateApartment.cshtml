@using DotHotel.Core.DataTransferObjects.ApartmentObjects
@model ApartmentAddRequest
@{
    ViewData["Title"] = "Create New Apartment";
    Layout = "_Layout";
}

<div class="container mt-3">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-area="Administrator" asp-controller="Apartment" asp-action="Index">Apartments</a>
                    </li>
                    <li class="breadcrumb-item active">Create New</li>
                </ol>
            </nav>
            <h1 class="h2">Create New Apartment</h1>
        </div>
    </div>

    <form asp-area="Administrator" asp-controller="Apartment" asp-action="CreateApartment" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Basic Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                <i class="fas fa-home me-1"></i>Apartment Name
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="e.g., Luxury Suite with Ocean View" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                <i class="fas fa-align-left me-1"></i>Description
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="5"
                                      placeholder="Describe the apartment's features, amenities, and what makes it special..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                            <small class="text-muted">Maximum 1500 characters</small>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Capacity" class="form-label">
                                    <i class="fas fa-users me-1"></i>Guest Capacity
                                </label>
                                <input asp-for="Capacity" type="number" class="form-control" min="1" placeholder="Number of guests" />
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Rating" class="form-label">
                                    <i class="fas fa-star me-1"></i>Initial Rating
                                </label>
                                <select asp-for="Rating" class="form-select">
                                    <option value="1">1 Star</option>
                                    <option value="2">2 Stars</option>
                                    <option value="3">3 Stars</option>
                                    <option value="4">4 Stars</option>
                                    <option value="5">5 Stars</option>
                                </select>
                                <span asp-validation-for="Rating" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Apartment Images</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-images me-1"></i>Upload Images
                            </label>
                            <input id="ImageFiles" type="file" class="form-control" multiple accept=".png,.jpg,.jpeg,.gif,.webp" />
                            <small class="text-muted">Accepted formats: PNG, JPG, JPEG, GIF, WEBP. You can select multiple files.</small>
                        </div>

                        <div id="imageSection" style="display:none;">
                            <h6 class="text-muted mb-2">Uploaded Images:</h6>

                            <div id="imageMessages"></div>

                            <div id="imagePreview" class="row g-2 mt-1"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Pricing & Status</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="PricePerNightPerPersonUsd" class="form-label">
                                <i class="fas fa-dollar-sign me-1"></i>Price per Night per Person (USD)
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PricePerNightPerPersonUsd" type="number" step="0.01" min="0.01"
                                       class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="PricePerNightPerPersonUsd" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                <label asp-for="IsActive" class="form-check-label">
                                    Active
                                    <small class="text-muted d-block">Apartment will be visible to customers</small>
                                </label>
                            </div>
                            <span asp-validation-for="IsActive" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Create Apartment
                            </button>
                            <a asp-area="Administrator" asp-controller="Apartment" asp-action="Index"
                               class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ClientSideValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            let base64Images = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model?.ApartmentImagesBase64 ?? new List<string>()))
            updateHiddenFields();
            renderPreview();

            function updateHiddenFields() {
                $('input[name^="ApartmentImagesBase64"]').remove();

                base64Images.forEach((base64, index) => {
                    $('<input>').attr({
                        type: 'hidden',
                        name: `ApartmentImagesBase64[${index}]`,
                        value: base64
                    }).appendTo('form');
                });
            }

            function renderPreview() {
                const $previewContainer = $('#imagePreview');
                $previewContainer.empty();

                if (base64Images.length === 0) {
                    $('#imageSection').hide();
                    return;
                }

                $('#imageSection').show();

                base64Images.forEach((base64, index) => {
                    const imageHtml = `
                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="position-relative">
                                <img src="${base64}" class="img-fluid rounded shadow-sm" style="height: 120px; width: 100%; object-fit: cover;">
                                <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 remove-image" data-index="${index}">&times;</button>
                            </div>
                        </div>`;
                    $previewContainer.append(imageHtml);
                });
            }

            function clearMessages() {
                $("#imageMessages").empty();
            }

            function showErrorMessage(message) {
                const alertHtml = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                $("#imageMessages").append(alertHtml);
            }

            $('#ImageFiles').on('change', function (e) {
                const files = e.target.files;
                if (!files || files.length === 0) return;

                clearMessages();

                const allowedTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/gif', 'image/webp'];
                const maxFileSize = 5 * 1024 * 1024;

                Array.from(files).forEach(file => {
                    if (!allowedTypes.includes(file.type)) {
                        showErrorMessage(`File type not allowed: ${file.name}`);
                        return;
                    }
                    if (file.size > maxFileSize) {
                        showErrorMessage(`File is too large: ${file.name}`);
                        return;
                    }

                    const reader = new FileReader();
                    reader.onload = function (e) {
                        base64Images.push(e.target.result);
                        renderPreview();
                        updateHiddenFields();
                    };
                    reader.readAsDataURL(file);
                });

                $('#ImageFiles').val('');
            });

            $('#imagePreview').on('click', '.remove-image', function () {
                const index = $(this).data('index');
                base64Images.splice(index, 1);
                renderPreview();
                updateHiddenFields();
            });
        });
    </script>


    <style>
        .remove-image {
            width: 28px;
            height: 28px;
            font-size: 18px;
            padding: 0;
            border-radius: 50%;
            opacity: 0.85;
        }

            .remove-image:hover {
                opacity: 1;
                transform: scale(1.2);
            }
    </style>
}
