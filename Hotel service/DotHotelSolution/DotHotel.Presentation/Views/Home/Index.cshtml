@{
    ViewData["Title"] = "Welcome to DotHotel";
    Layout = "_Layout";
}

<section class="bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center min-vh-50">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4 text-white">Welcome to DotHotel</h1>
                <p class="lead mb-4 text-white">
                    Discover luxury apartment rentals in the heart of the city.
                    Experience comfort, style, and convenience like never before.
                </p>
                <div class="d-flex gap-3">
                    <a asp-controller="Apartment" asp-action="Index" class="btn btn-light btn-lg">
                        <i class="fas fa-search me-2"></i>Find Apartments
                    </a>
                    <a asp-controller="Home" asp-action="About" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-info-circle me-2"></i>Learn More
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <i class="fas fa-building display-1 text-white opacity-75"></i>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="h1 mb-3">Why Choose DotHotel?</h2>
                <p class="lead text-muted">We provide the best apartment rental experience</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="text-primary mb-3">
                            <i class="fas fa-star fa-3x"></i>
                        </div>
                        <h5 class="card-title">Premium Quality</h5>
                        <p class="card-text text-muted">
                            All our apartments are carefully selected and maintained to the highest standards.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="text-primary mb-3">
                            <i class="fas fa-map-marker-alt fa-3x"></i>
                        </div>
                        <h5 class="card-title">Prime Locations</h5>
                        <p class="card-text text-muted">
                            Located in the best neighborhoods with easy access to transportation and amenities.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="text-primary mb-3">
                            <i class="fas fa-headset fa-3x"></i>
                        </div>
                        <h5 class="card-title">24/7 Support</h5>
                        <p class="card-text text-muted">
                            Our dedicated support team is available around the clock to assist you.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5">
    <div class="container">
        <div class="row text-center">
            <div class="col-12">
                <h2 class="h1 mb-3">Ready to Find Your Perfect Stay?</h2>
                <p class="lead text-muted mb-4">
                    Browse our collection of premium apartments and book your next stay today.
                </p>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Apartment" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="fas fa-building me-2"></i>Browse Apartments
                    </a>
                }
                else
                {
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">
                            <i class="fas fa-user-plus me-2"></i>Get Started
                        </a>
                        <a asp-controller="Apartment" asp-action="Index" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-eye me-2"></i>View Apartments
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <h3 class="display-6 text-primary fw-bold">500+</h3>
                    <p class="text-muted mb-0">Premium Apartments</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <h3 class="display-6 text-primary fw-bold">10k+</h3>
                    <p class="text-muted mb-0">Happy Guests</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <h3 class="display-6 text-primary fw-bold">50+</h3>
                    <p class="text-muted mb-0">Cities Worldwide</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="p-3">
                    <h3 class="display-6 text-primary fw-bold">24/7</h3>
                    <p class="text-muted mb-0">Customer Support</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .min-vh-50 {
            min-height: 50vh;
        }

        .bg-gradient-primary {
            background: linear-gradient(135deg, var(--primary-color) 0%, #3730a3 100%);
        }

        .card:hover {
            transform: translateY(-5px);
            transition: transform 0.3s ease;
        }
    </style>
}