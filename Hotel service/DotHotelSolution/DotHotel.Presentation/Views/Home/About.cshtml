@{
    ViewData["Title"] = "About Us";
    Layout = "_Layout";
}

<section class="bg-light py-5">
    <div class="container">
        <div class="row text-center">
            <div class="col-12">
                <h1 class="display-4 fw-bold mb-3">About DotHotel</h1>
                <p class="lead text-muted">
                    Redefining apartment rentals with luxury, comfort, and exceptional service
                </p>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="h1 mb-4">Our Story</h2>
                <p class="text-muted mb-4">
                    Founded in 2020, DotHotel was born from a simple idea: everyone deserves access to
                    premium accommodation that feels like home. We started with a single apartment in
                    downtown and have since grown to offer hundreds of luxury properties worldwide.
                </p>
                <p class="text-muted mb-4">
                    Our mission is to provide guests with exceptional stays while offering property
                    owners a reliable platform to showcase their premium apartments. Every property
                    in our collection is hand-picked and meets our strict quality standards.
                </p>
                <div class="d-flex gap-2">
                    <i class="fas fa-check text-success me-2"></i>
                    <span>Hand-picked premium properties</span>
                </div>
                <div class="d-flex gap-2">
                    <i class="fas fa-check text-success me-2"></i>
                    <span>24/7 customer support</span>
                </div>
                <div class="d-flex gap-2">
                    <i class="fas fa-check text-success me-2"></i>
                    <span>Secure booking system</span>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="p-5">
                    <i class="fas fa-building display-1 text-primary opacity-75"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="h1 mb-3">Our Values</h2>
                <p class="lead text-muted">What drives us every day</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="text-center">
                    <div class="text-primary mb-3">
                        <i class="fas fa-heart fa-3x"></i>
                    </div>
                    <h5>Guest-Centric</h5>
                    <p class="text-muted">
                        Every decision we make is centered around creating the best possible
                        experience for our guests.
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="text-center">
                    <div class="text-primary mb-3">
                        <i class="fas fa-shield-alt fa-3x"></i>
                    </div>
                    <h5>Trust & Safety</h5>
                    <p class="text-muted">
                        We maintain the highest standards of safety and security for both
                        guests and property owners.
                    </p>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="text-center">
                    <div class="text-primary mb-3">
                        <i class="fas fa-rocket fa-3x"></i>
                    </div>
                    <h5>Innovation</h5>
                    <p class="text-muted">
                        We continuously improve our platform and services using the latest
                        technology and user feedback.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-12">
                <h2 class="h1 mb-3">Our Team</h2>
                <p class="lead text-muted">Meet the people behind DotHotel</p>
            </div>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="text-primary mb-3">
                            <i class="fas fa-user-circle fa-4x"></i>
                        </div>
                        <h5 class="card-title">John Smith</h5>
                        <p class="text-muted mb-2">CEO & Founder</p>
                        <p class="card-text text-muted small">
                            Passionate about hospitality and technology, John founded DotHotel
                            to revolutionize apartment rentals.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="text-primary mb-3">
                            <i class="fas fa-user-circle fa-4x"></i>
                        </div>
                        <h5 class="card-title">Sarah Johnson</h5>
                        <p class="text-muted mb-2">Head of Operations</p>
                        <p class="card-text text-muted small">
                            With 10+ years in hospitality, Sarah ensures every guest
                            has an exceptional experience.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="text-primary mb-3">
                            <i class="fas fa-user-circle fa-4x"></i>
                        </div>
                        <h5 class="card-title">Mike Chen</h5>
                        <p class="text-muted mb-2">CTO</p>
                        <p class="card-text text-muted small">
                            Tech expert who built our platform from the ground up,
                            focusing on security and user experience.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-dark text-white py-5">
    <div class="container">
        <div class="row text-center">
            <div class="col-12">
                <h2 class="h1 mb-3 text-white">Ready to Experience DotHotel?</h2>
                <p class="lead mb-4 text-white">
                    Join thousands of satisfied guests who have made DotHotel their home away from home.
                </p>
                <a asp-controller="Apartment" asp-action="Index" class="btn btn-light btn-lg">
                    <i class="fas fa-search me-2"></i>Start Your Search
                </a>
            </div>
        </div>
    </div>
</section>