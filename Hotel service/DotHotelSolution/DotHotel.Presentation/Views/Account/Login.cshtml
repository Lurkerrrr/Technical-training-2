@using DotHotel.Core.DataTransferObjects.IdentityObjects

@model LoginObject
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="container mt-3">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h2 class="card-title">Sign In</h2>
                        <p class="text-muted">Enter your credentials to access your account</p>
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="post">

                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                        {
                            <div class="alert alert-danger text-center">
                                <div asp-validation-summary="All" class="mb-0"></div>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">Username</label>
                            <input asp-for="UserName" class="form-control" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary w-100">Login</button>
                        </div>
                    </form>

                    <div class="text-center">
                        <p class="mb-0">
                            Don't have an account?
                            <a asp-controller="Account" asp-action="Register">Register here</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .validation-summary-errors ul {
            list-style: none !important;
            padding-left: 0 !important;
            margin: 0 !important;
        }

        .validation-summary-errors li {
            margin: 0 !important;
        }
    </style>
}

@section Scripts {   
    <partial name="_ClientSideValidationScriptsPartial"></partial>
}