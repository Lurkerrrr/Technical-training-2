@using DotHotel.Core.DataTransferObjects.ApartmentObjects

@model List<ApartmentResponse>
@{
    ViewData["Title"] = "Apartments";
    Layout = "_Layout";
    var searchOptions = ViewBag.SearchOptions as ApartmentSearchOptions ?? new ApartmentSearchOptions();
}

<div class="container mt-3">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 mb-2">Our Apartments</h1>
            <p class="text-muted">Discover amazing places to stay</p>
        </div>
    </div>

    <partial name="Partial/_ApartmentSearchOptions" model="searchOptions" />

    <div class="row g-4 mb-4">
        @if (Model.Any())
        {
            @foreach (var apartment in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="position-relative">
                            @if (apartment.ApartmentImagesBase64?.Any() == true)
                            {
                                <img src="@apartment.ApartmentImagesBase64.First()" class="card-img-top"
                                     alt="@apartment.Name" style="height: 250px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                     style="height: 250px;">
                                    <i class="fas fa-home fa-4x text-muted"></i>
                                </div>
                            }
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-primary fs-6 px-3 py-2">
                                    $@apartment.PricePerNightPerPersonUsd<small>/night</small>
                                </span>
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-2">@apartment.Name</h5>
                            <p class="card-text text-muted flex-grow-1 mb-3">
                                @if (apartment.Description.Length > 100)
                                {
                                    @(apartment.Description.Substring(0, 100) + "...")
                                }
                                else
                                {
                                    @apartment.Description
                                }
                            </p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex gap-3">
                                    <small class="text-muted">
                                        <i class="fas fa-users me-1"></i>@apartment.Capacity guests
                                    </small>
                                    <small class="text-muted">
                                        <i class="fas fa-star text-warning me-1"></i>@apartment.Rating.ToString("0.0")
                                    </small>
                                </div>
                            </div>
                            <div class="d-grid">
                                <a asp-area="" asp-controller="Apartment" asp-action="ApartmentDetails" asp-route-apartmentId="@apartment.Id"
                                   class="btn btn-primary">
                                    <i class="fas fa-eye me-2"></i>View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="fas fa-building fa-4x text-muted mb-4"></i>
                    <h4>No apartments available</h4>
                    <p class="text-muted">Try adjusting your filters or check back later for new listings</p>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ClientSideValidationScriptsPartial" />
    <script src="~/js/filters/apartment-filters.js"></script>
}