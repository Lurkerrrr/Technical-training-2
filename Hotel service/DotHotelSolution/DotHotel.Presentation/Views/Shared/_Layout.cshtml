@using System.Text.Encodings.Web
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DotHotel</title>
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar">
        <div class="container">
            <div class="d-flex align-items-center">
                <a class="navbar-brand me-4" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-hotel me-2"></i>DotHotel
                </a>
                
                <div class="d-flex gap-3">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home me-1"></i>Home
                    </a>
                    <a class="nav-link" asp-area="" asp-controller="Apartment" asp-action="Index">
                        <i class="fas fa-building me-1"></i>Apartments
                    </a>
                    <a class="nav-link" asp-controller="Home" asp-action="About">
                        <i class="fas fa-info-circle me-1"></i>About
                    </a>
                    <a class="nav-link" asp-controller="Home" asp-action="Contact">
                        <i class="fas fa-envelope me-1"></i>Contact
                    </a>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <!-- Authenticated User -->
                    <a class="nav-link" asp-area="" asp-controller="Reservation" asp-action="Index">
                        <i class="fas fa-calendar-check me-1"></i>My Reservations
                    </a>
                    
                    @if (User.IsInRole("Administrator"))
                    {
                        <a class="nav-link" asp-area="Administrator" asp-controller="Apartment" asp-action="Index">
                            <i class="fas fa-tachometer-alt me-1"></i>Manage apartments
                        </a>

                        <a class="nav-link" asp-area="Administrator" asp-controller="Reservation" asp-action="Index">
                            <i class="fas fa-tachometer-alt me-1"></i>Manage reservations
                        </a>
                    }
                    
                    <a class="nav-link" href="#">
                        <i class="fas fa-user me-1"></i>@User.Identity.Name
                    </a>
                    
                    <a class="nav-link" asp-controller="Account" asp-action="Logout">
                            <i class="fas fa-sign-out-alt me-1"></i>Logout
                    </a>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Register">
                        <i class="fas fa-user-plus me-1"></i>Register
                    </a>
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">
                        <i class="fas fa-sign-in-alt me-1"></i>Login
                    </a>
                }
            </div>
        </div>
    </nav>

    <main role="main" class="py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-primary text-white py-4 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="text-white mb-3">
                        <i class="fas fa-hotel me-2"></i>DotHotel
                    </h5>
                    <p class="text-white-50 mb-0">
                        Your premier destination for luxury apartment rentals.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="text-white-50 mb-0">
                        &copy; @DateTime.Now.Year DotHotel. All rights reserved.
                    </p>
                    <p class="text-white-50 mb-0">
                        Built with <i class="fas fa-heart text-danger"></i> using ASP.NET Core
                    </p>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>

    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "5000"
        };
    </script>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            toastr.error('@Html.Raw(JavaScriptEncoder.Default.Encode(TempData["ErrorMessage"]?.ToString() ?? string.Empty))');
        </script>
    }

    @RenderSection("Styles", required: false)
    @RenderSection("Scripts", required: false)
</body>
</html>